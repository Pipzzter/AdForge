  "image_context_rules": {
    "headline_image": {
      "context_source": "headline + introduction",
      "description": "Hero image representing the entire page topic/theme"
    },
    "author_image": {
      "context_source": "author_info",
      "description": "Professional headshot matching author name/credentials"
    },
    "body_section_image": {
      "context_source": "body section content (same REPEAT block)",
      "description": "Image relevant to THAT specific body section's content"
    },
    "product_image": {
      "context_source": "product_content",
      "description": "Clear product shot or product-in-use image"
    },
    "case_study_image": {
      "context_source": "case_study content",
      "description": "Image relevant to the case study - before/after, person, or situation"
    },
    "listicle_item_image": {
      "context_source": "listicle item content (same REPEAT block)",
      "description": "Image illustrating THAT specific numbered point"
    },
    "social_proof_image": {
      "context_source": "social_proof content (same REPEAT block)",
      "description": "Photo of expert/doctor/authority providing the social proof"
    },
    "main_social_proof_image": {
      "context_source": "main_social_proof content",
      "description": "Charts, study graphics, credentials supporting main social proof"
    },
    "review_person_image": {
      "context_source": "review content (same REPEAT block)",
      "description": "Realistic human photo matching reviewer name/demographic"
    },
    "offer_image": {
      "context_source": "offer_content",
      "description": "Product packaging, bundle, or promotional image"
    }
